rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL MASTER BYPASS ---
    // If the authenticated user's UID exists in the root 'global_admins' collection,
    // they bypass all restriction blocks and have unrestricted read/write access to the entire database.
    match /{document=**} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/global_admins/$(request.auth.uid));
    }

    // --- SELF-LOCKING BOOTSTRAP GATE ---
    match /global_admins/{adminId} {
      // 1. Any logged-in user is allowed to read the static '_lock' document to check if the database is initialized.
      // 2. Users can only read their own registration document, or existing global admins can read any document.
      allow read: if request.auth != null && 
                    (adminId == '_lock' || 
                     adminId == request.auth.uid || 
                     exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)));
      
      // Write/Create is allowed IF:
      // 1. The lock document '_lock' does NOT exist (meaning the database is brand new and in Setup Mode).
      // 2. Or, if the caller is already a registered Global Owner, they can add/edit other global owners.
      allow create, update: if request.auth != null && 
                              (!exists(/databases/$(database)/documents/global_admins/_lock) || 
                               exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)));
                               
      // Only existing Global Owners can delete administrative entries
      allow delete: if request.auth != null && exists(/databases/$(database)/documents/global_admins/$(request.auth.uid));
    }

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Fetch the current user's document inside a specific church using their verified EMAIL as the key
    function getMisterData(churchId) {
      return exists(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email)).data
        : get(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email.lower())).data;
    }
    
    // Helper: Does the user have admin rights in this church? (Verified via Google Email)
    function isChurchAdmin(churchId) {
      return isAuthenticated() && 
             (exists(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email)) ||
              exists(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email.lower()))) &&
             (getMisterData(churchId).churchRole == 'Admin' || getMisterData(churchId).churchRole == 'admin');
    }

    // Helper: Is the user a registered servant in this church? (Verified via Google Email)
    function isChurchServant(churchId) {
      return isAuthenticated() && 
             (exists(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email)) ||
              exists(/databases/$(database)/documents/churches/$(churchId)/misters/$(request.auth.token.email.lower()))) &&
             getMisterData(churchId).active == true;
    }

    // Helper: Does the user have Group Admin rights in this service group?
    function isGroupAdmin(churchId, serviceGroupId) {
      return isAuthenticated() && (
        isChurchAdmin(churchId) ||
        (
          exists(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)) &&
          (
            get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.misters[request.auth.token.email] == 'admin' ||
            (get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.admins != null &&
             request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.admins)
          )
        )
      );
    }

    // Helper: Is the user a servant in this service group?
    function isGroupServant(churchId, serviceGroupId) {
      return isAuthenticated() && (
        isGroupAdmin(churchId, serviceGroupId) ||
        (
          exists(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)) &&
          (
            (get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.misters != null &&
             request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.misters) ||
            (get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.servants != null &&
             request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)/serviceGroups/$(serviceGroupId)).data.servants)
          )
        )
      );
    }

    // --- CHURCHES COLLECTION ---
    match /churches/{churchId} {
      // Allow read to ANY authenticated user so they can view church names and request to join!
      allow read: if isAuthenticated();
      
      // Allow write if the database is in Setup Mode (no lock), or if the user is a Global Owner.
      allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                    (request.auth != null && exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)));

      // --- SUBCOLLECTIONS ---
      
      // Join Requests subcollection (for unapproved users requesting access)
      match /joinRequests/{email} {
        // Any logged-in user can read/write their own request. Admins can read/delete them.
        allow read: if isAuthenticated() && (email == request.auth.token.email || isChurchAdmin(churchId));
        allow create: if isAuthenticated() && email == request.auth.token.email;
        allow delete: if isAuthenticated() && (email == request.auth.token.email || isChurchAdmin(churchId));
        allow update: if isChurchAdmin(churchId);
      }

      // Misters (Teachers/Servants, locked by Email Key)
      match /misters/{misterEmail} {
        // A servant can read other servants, and any authenticated user can read their own registration
        allow read: if isAuthenticated() && (
          misterEmail == request.auth.token.email || 
          misterEmail.lower() == request.auth.token.email.lower() || 
          isChurchServant(churchId)
        );

        // Allow create or delete if setup mode, or if Church Admin
        allow create, delete: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                              isChurchAdmin(churchId);

        // Allow update if setup mode, Church Admin, OR if a servant is updating strictly their OWN personal profile fields!
        allow update: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                      isChurchAdmin(churchId) ||
                      (
                        isAuthenticated() && 
                        (misterEmail == request.auth.token.email || misterEmail.lower() == request.auth.token.email.lower()) && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'personalInfo', 
                          'displayName', 
                          'lastEditAt', 
                          'lastEditBy', 
                          'email'
                        ])
                      );
      }
      
      // Attendance Events directly under church
      match /attendanceEvents/{eventId} {
        allow read, write: if isChurchServant(churchId);
      }
      
      // Kids Directory (PII)
      match /kids/{kidId} {
        allow read, write: if isChurchServant(churchId);
        
        match /versions/{versionId} {
          allow read, write: if isChurchServant(churchId);
        }
      }
      
      // Service Groups
      match /serviceGroups/{serviceGroupId} {
        allow read, write: if isChurchServant(churchId);
        
        match /mistersMemberships/{memId} {
          allow read: if isChurchServant(churchId);
          allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                        isChurchAdmin(churchId);
        }
      }

      // Classes
      match /classes/{classId} {
        allow read: if isChurchServant(churchId);
        allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                      isChurchAdmin(churchId);
      }

      // --- ACADEMIC YEAR SCOPED DATA ---
      match /academicYears/{yearId} {
        allow read: if isChurchServant(churchId);
        allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                      isChurchAdmin(churchId);

        // Classes under Academic Year
        match /classes/{classId} {
          allow read: if isChurchAdmin(churchId) || isChurchServant(churchId);
          allow write: if isChurchAdmin(churchId);

          // Attendance Events stored under Academic Year -> Class
          match /attendanceEvents/{eventId} {
            // 1. View access: Church Admin, or any servant in the class's service group
            allow read: if isChurchAdmin(churchId) || 
                           isGroupServant(churchId, get(/databases/$(database)/documents/churches/$(churchId)/classes/$(classId)).data.academicYears[yearId].serviceGroupId);

            // 2. Edit access: Church Admin, Group Admin of this service group, or designated Class Mister
            allow write: if isChurchAdmin(churchId) || 
                            isGroupAdmin(churchId, get(/databases/$(database)/documents/churches/$(churchId)/classes/$(classId)).data.academicYears[yearId].serviceGroupId) ||
                            (
                              request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)/classes/$(classId)).data.academicYears[yearId].Misters ||
                              request.auth.token.email in get(/databases/$(database)/documents/churches/$(churchId)/classes/$(classId)).data.academicYears[yearId].MistersIds
                            );
          }
        }

        match /classInstances/{instanceId} {
          allow read: if isChurchServant(churchId);
          allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                        isChurchAdmin(churchId);
        }

        match /attendanceEvents/{eventId} {
          allow read, write: if isChurchServant(churchId);
        }

        match /homeVisitsByClassInstance/{instanceId}/visits/{visitId} {
          allow read, write: if isChurchServant(churchId);
        }
      }
    }
  }
}
