rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL MASTER BYPASS ---
    // If the authenticated user's UID exists in the root 'global_admins' collection,
    // they bypass all restriction blocks and have unrestricted read/write access to the entire database.
    match /{document=**} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/global_admins/$(request.auth.uid));
    }

    // --- SELF-LOCKING BOOTSTRAP GATE ---
    match /global_admins/{adminId} {
      // 1. Any logged-in user is allowed to read the static '_lock' document to check if the database is initialized.
      // 2. Users can only read their own registration document, or existing global admins can read any document.
      allow read: if request.auth != null && 
                    (adminId == '_lock' || 
                     adminId == request.auth.uid || 
                     exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)));
      
      // Write/Create is allowed IF:
      // 1. The lock document '_lock' does NOT exist (meaning the database is brand new and in Setup Mode).
      // 2. Or, if the caller is already a registered Global Owner, they can add/edit other global owners.
      allow create, update: if request.auth != null && 
                              (!exists(/databases/$(database)/documents/global_admins/_lock) || 
                               exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)));
                               
      // Only existing Global Owners can delete administrative entries
      allow delete: if request.auth != null && exists(/databases/$(database)/documents/global_admins/$(request.auth.uid));
    }

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Fetch the current user's document inside a specific church
    function getMisterData(churchId) {
      return get(/databases/$(database)/documents/churches/{churchId}/misters/$(request.auth.uid)).data;
    }
    
    // Helper: Does the user have admin rights in this church?
    function isChurchAdmin(churchId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/churches/{churchId}/misters/$(request.auth.uid)) &&
             getMisterData(churchId).churchRole == 'Admin';
    }

    // Helper: Is the user a registered servant in this church?
    function isChurchServant(churchId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/churches/{churchId}/misters/$(request.auth.uid)) &&
             getMisterData(churchId).active == true;
    }

    // --- CHURCHES COLLECTION ---
    match /churches/{churchId} {
      // Allow read if they are a servant. Only global admins can create/delete churches.
      allow read: if isChurchServant(churchId);
      
      // Allow write if the database is in Setup Mode (no lock), or if the user is a Global Owner.
      allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                    (request.auth != null && exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)));

      // --- SUBCOLLECTIONS ---
      
      // Misters (Teachers/Servants)
      match /misters/{misterId} {
        // A servant can read other servants. Only church admins can write.
        allow read: if isChurchServant(churchId);
        
        // Allow write if the database is in Setup Mode (no lock), or if the user is a Church Admin.
        allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                      isChurchAdmin(churchId);
      }
      
      // Kids Directory (PII)
      match /kids/{kidId} {
        allow read, write: if isChurchServant(churchId);
        
        match /versions/{versionId} {
          allow read, write: if isChurchServant(churchId);
        }
      }
      
      // Service Groups
      match /serviceGroups/{serviceGroupId} {
        allow read, write: if isChurchServant(churchId);
        
        match /mistersMemberships/{memId} {
          allow read: if isChurchServant(churchId);
          allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                        isChurchAdmin(churchId);
        }
      }

      // Classes
      match /classes/{classId} {
        allow read: if isChurchServant(churchId);
        allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                      isChurchAdmin(churchId);
      }

      // --- ACADEMIC YEAR SCOPED DATA ---
      match /academicYears/{yearId} {
        allow read: if isChurchServant(churchId);
        allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                      isChurchAdmin(churchId);

        match /classInstances/{instanceId} {
          allow read: if isChurchServant(churchId);
          allow write: if (request.auth != null && !exists(/databases/$(database)/documents/global_admins/_lock)) ||
                        isChurchAdmin(churchId);
        }

        match /attendanceEvents/{eventId} {
          allow read, write: if isChurchServant(churchId);
        }

        match /homeVisitsByClassInstance/{instanceId}/visits/{visitId} {
          allow read, write: if isChurchServant(churchId);
        }
      }
    }
  }
}
